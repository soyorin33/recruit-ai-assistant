# ================= 大模型（任选其一，OpenAI 兼容接口；不填则使用本地规则引擎演示）=================
# DeepSeek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 腾讯混元（hunyuan-lite 免费额度）
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-lite
# 阿里通义千问
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ================= 企业微信自建应用（接收 HR 消息 + 回复 + 智能表格 API）=================
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 「接收消息」设置里的 Token / EncodingAESKey，回调地址填 https://你的域名/wecom/callback
WECOM_TOKEN=
WECOM_AES_KEY=

# ================= 企微智能表格（候选人总表，HR 日常查看的单一数据源）=================
SMARTSHEET_DOCID=
SMARTSHEET_SHEET_ID=

# ================= 企微群机器人（推送日报 / 跟进提醒）=================
WECOM_WEBHOOK_URL=

# ================= 业务参数 =================
# 低于该置信度的 AI 结果转人工确认
CONFIDENCE_THRESHOLD=0.8
# 超过 N 天无进展触发预警
STALE_DAYS=3
# 每日日报推送时间
REPORT_TIME=18:00
# 每日跟进提醒推送时间
ALERT_TIME=10:00
# 首次启动生成演示数据（正式使用改为 0）
SEED_DEMO_DATA=1
