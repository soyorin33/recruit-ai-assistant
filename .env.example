# ================= 大模型（任选其一，OpenAI 兼容接口；不填则使用本地规则引擎演示）=================
# DeepSeek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 腾讯混元（hunyuan-lite 免费额度）
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-lite
# 阿里通义千问
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 视觉模型（截图识别，可选）：默认复用上面的 Key 和地址，只需填模型名；DeepSeek 对话模型不支持图片
# VISION_MODEL=qwen-vl-plus
# VISION_BASE_URL=
# VISION_API_KEY=

# ================= 企业微信自建应用（接收 HR 消息 + 回复 + 智能表格 API）=================
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 「接收消息」设置里的 Token / EncodingAESKey，回调地址填 https://你的域名/wecom/callback
WECOM_TOKEN=
WECOM_AES_KEY=

# ================= 企微「智能机器人」（群里 @招聘助手，可选）=================
# 方式一（推荐）长连接：创建机器人时接入方式选「长连接」，只填 Bot ID 和 Secret，不需要域名 / HTTPS / 备案
# 注意：同一个机器人同时只能有一个程序连接（本机和服务器不要同时开）
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
# 方式二 URL 回调：回调地址填 https://你的域名/wecom/aibot（域名主体一般需与企业一致）
WECOM_AIBOT_TOKEN=
WECOM_AIBOT_AES_KEY=

# ================= 腾讯文档智能表格（官方 MCP，候选人总表实时写入，推荐）=================
# 1. 个人版在 https://docs.qq.com/open/auth/mcp.html 生成 Token；企业版在 saas.docs.qq.com 的 OpenClaw 接入页复制 token
# 2. 运行 python -m scripts.tdocs_setup：自动识别个人版 / 企业版，新建「招聘候选人总表」并写好下面几项
TDOCS_TOKEN=
TDOCS_MCP_URL=
TDOCS_FILE_ID=
TDOCS_SHEET_ID=
TDOCS_URL=

# ================= 企微智能表格（需要自建应用权限，个人注册的企业一般用不了）=================
SMARTSHEET_DOCID=
SMARTSHEET_SHEET_ID=

# ================= 企微账号 → 中文名（「负责HR」显示用，可选）=================
# 企微后台「通讯录」里成员的「账号」=中文名，多个用逗号分隔
WECOM_USER_NAMES=

# ================= 企微群机器人（推送日报 / 跟进提醒，可选：招聘助手会自己推送，这里只作备用）=================
WECOM_WEBHOOK_URL=

# ================= 访问控制（部署到公网时必须设置）=================
# 看板与接口的访问口令；留空则不启用登录（仅适合本机演示）。请使用字母、数字和符号（脚本通过 Authorization 头调用时不支持中文）
ACCESS_TOKEN=
# 登录有效期（小时）
SESSION_HOURS=72

# ================= 业务参数 =================
# 低于该置信度的 AI 结果转人工确认
CONFIDENCE_THRESHOLD=0.8
# 超过 N 天无进展触发预警
STALE_DAYS=3
# 每日日报推送时间
REPORT_TIME=18:00
# 每日跟进提醒推送时间
ALERT_TIME=10:00
# 首次启动生成演示数据（正式使用改为 0）
SEED_DEMO_DATA=1
